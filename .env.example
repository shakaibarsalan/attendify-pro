# =============================================
# ATTENDIFY - Environment Variables
# Copy to .env and replace every <...> placeholder. Never commit .env.
# Generate secrets with:  openssl rand -hex 32
# =============================================

# Main PostgreSQL database
# (docker compose overrides DB_HOST/DB_PORT for the containers; these values
#  are for running the server on your host against the published port)
DB_HOST=localhost
DB_PORT=15432
DB_NAME=attendify
DB_USER=attendify_user
DB_PASSWORD=<generate-a-strong-password>
DB_SSL=false

# Biometric PostgreSQL database (pgvector, kept separate from app data)
BIOMETRIC_DB_HOST=localhost
BIOMETRIC_DB_PORT=15433
BIOMETRIC_DB_NAME=attendify_biometric
BIOMETRIC_DB_USER=biometric_user
BIOMETRIC_DB_PASSWORD=<generate-a-strong-password>

# Auth (JWT)
JWT_SECRET=<generate-a-32+-char-random-string>
JWT_REFRESH_SECRET=<generate-a-different-32+-char-random-string>
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
# true = refuse to boot in production with placeholder secrets
STRICT_SECRETS=false

# Server
SERVER_PORT=5000
SERVER_URL=http://localhost:5000
NODE_ENV=development
FRONTEND_URL=https://localhost
CORS_ORIGIN=https://localhost,http://localhost,http://localhost:5173,http://localhost:3000
# Full internal Swagger at /api-docs (dev only unless set to true)
ENABLE_API_DOCS=false

# Public API (API-key access for third-party integrations)
PUBLIC_API_ENABLED=true
PUBLIC_API_RATE_LIMIT=100

# AI service (FastAPI). The server sends AI_SERVICE_API_KEY as X-API-Key.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=<generate-a-random-api-key>
# Signs liveness challenges and short-lived presence passes
LIVENESS_HMAC_SECRET=<generate-a-32+-char-random-string>

# Landing-page assistant (Groq) - powers the public /api/chat chatbot.
# Optional. Server-side only; never expose this key in a frontend bundle.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# Rotating QR window (seconds)
QR_ROTATION_INTERVAL_S=15

# Idempotency-Key TTL (seconds)
IDEMPOTENCY_TTL_S=60

# Background jobs (always on in production)
ENABLE_JOBS=false

# Logging
LOG_LEVEL=debug

# Redis (optional; in-memory fallback when unset)
REDIS_URL=redis://localhost:6379

# Email (optional - password reset, welcome mails, alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Attendify

# Where ops alerts go when a DB or the AI service goes down (falls back to SMTP_FROM)
ALERT_EMAIL=
# Comma-separated inboxes notified about new "Get Started" / "Book a Demo" leads
LEAD_NOTIFY_EMAILS=
# Scheduling link included in the "book a demo" email
DEMO_SCHEDULING_URL=

# Backups (scripts/backup-db.sh, db/backup.sh)
BACKUP_KEEP_DAYS=14
BACKUP_PASSPHRASE=<generate-a-strong-passphrase>
