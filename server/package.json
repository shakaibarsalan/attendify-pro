{
  "name": "attendify-server",
  "version": "2.0.0",
  "description": "Attendify - Smart Attendance System Backend API",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "db:migrate": "tsx src/utils/migrate.ts",
    "test": "vitest run",
